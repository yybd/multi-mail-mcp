{
  "name": "@yybd/multi-mail-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.yybd/multi-mail-mcp",
  "description": "MCP server for several Gmail accounts \u2014 search, read, draft, send, attachments, labels and Google Calendar \u2014 for Claude Desktop, Claude Code and ChatGPT",
  "license": "MIT",
  "author": "yybd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yybd/multi-mail-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "email",
    "claude",
    "chatgpt",
    "multi-account",
    "calendar",
    "google-calendar"
  ],
  "type": "module",
  "bin": {
    "multi-mail-mcp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:http": "node dist/main.js http",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/http.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx scripts/test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@googleapis/calendar": "20.1.0",
    "@googleapis/gmail": "^22.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "README.he.md",
    "LICENSE"
  ],
  "main": "dist/server.js",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/yybd/multi-mail-mcp#readme",
  "bugs": {
    "url": "https://github.com/yybd/multi-mail-mcp/issues"
  }
}
